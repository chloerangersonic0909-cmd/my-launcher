<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0A0B0F">

    <ScrollView
        android:layout_width="132dp"
        android:layout_height="match_parent"
        android:background="#121419"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="16dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/edit_profile_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/mylauncher_circle_button"
                    android:contentDescription="Accounts"
                    android:padding="9dp"
                    android:src="@drawable/ic_edit_profile"
                    android:tint="#7BE1F2" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="MY LAUNCHER"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="JAVA EDITION"
                        android:textColor="#9DA4B4"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#292D36" android:layout_marginTop="8dp" android:layout_marginBottom="12dp"/>

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/menu_play_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/mylauncher_dark_card"
                android:drawableStart="@drawable/ic_menu_home"
                android:text="Play"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textAllCaps="false" />
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/install_version_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/mylauncher_dark_card"
                android:drawableStart="@android:drawable/ic_menu_add"
                android:text="Installations"
                android:textColor="#D8DCE5"
                android:textSize="11sp"
                android:textAllCaps="false" />
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/menu_skins_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/mylauncher_dark_card"
                android:drawableStart="@drawable/ic_edit_profile"
                android:text="Skins"
                android:textColor="#D8DCE5"
                android:textSize="11sp"
                android:textAllCaps="false" />
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/news_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/mylauncher_dark_card"
                android:drawableStart="@drawable/ic_menu_news"
                android:text="Patch Notes"
                android:textColor="#D8DCE5"
                android:textSize="11sp"
                android:textAllCaps="false" />
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/download_center_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/mylauncher_dark_card"
                android:drawableStart="@drawable/ic_add_modded"
                android:text="Mods"
                android:textColor="#D8DCE5"
                android:textSize="11sp"
                android:textAllCaps="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp"
                android:text="TOOLS"
                android:textColor="#737D90"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"/>
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/install_jar_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/mylauncher_dark_card"
                android:drawableStart="@drawable/ic_menu_install_jar"
                android:text="Import JAR"
                android:textColor="#D8DCE5"
                android:textSize="10sp"
                android:textAllCaps="false"/>
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/custom_control_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/mylauncher_dark_card"
                android:drawableStart="@drawable/ic_menu_custom_controls"
                android:text="Controls"
                android:textColor="#D8DCE5"
                android:textSize="10sp"
                android:textAllCaps="false"/>
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/security_center_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/mylauncher_dark_card"
                android:drawableStart="@android:drawable/ic_lock_lock"
                android:text="Security"
                android:textColor="#D8DCE5"
                android:textSize="10sp"
                android:textAllCaps="false"/>
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/mylauncher_settings_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/mylauncher_dark_card"
                android:drawableStart="@drawable/ic_menu_settings"
                android:id="@+id/mylauncher_settings_button"
                android:text="Settings"
                android:textColor="#D8DCE5"
                android:textSize="10sp"
                android:textAllCaps="false"/>
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/discord_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/mylauncher_dark_card"
                android:drawableStart="@drawable/ic_discord"
                android:text="Community"
                android:textColor="#D8DCE5"
                android:textSize="10sp"
                android:textAllCaps="false"/>
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/share_logs_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/mylauncher_dark_card"
                android:drawableStart="@android:drawable/ic_menu_share"
                android:text="Share Logs"
                android:textColor="#D8DCE5"
                android:textSize="10sp"
                android:textAllCaps="false"/>
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/open_files_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/mylauncher_dark_card"
                android:drawableStart="@drawable/ic_folder"
                android:text="Game Files"
                android:textColor="#D8DCE5"
                android:textSize="10sp"
                android:textAllCaps="false"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#0A0B0F"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/mylauncher_brand_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="YOUR NEXT ADVENTURE"
                android:textColor="#B5BECF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JAVA EDITION"
                android:textColor="#58CBE5"
                android:textSize="10sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:background="@drawable/mylauncher_cosmos_background">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#55000000"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MINECRAFT"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JAVA EDITION"
                    android:textColor="#A9DFF0"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18"/>
                <TextView
                    android:id="@+id/background_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:padding="9dp"
                    android:background="#990A0B0F"
                    android:text="@string/mylauncher_game_not_running"
                    android:textColor="#EAEAF2"
                    android:textSize="11sp"/>
                <LinearLayout
                    android:id="@+id/background_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/background_permission_button"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="@string/mylauncher_enable_notifications"
                        android:textAllCaps="false"
                        android:textSize="9sp"/>
                    <Button
                        android:id="@+id/stop_game_button"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:enabled="false"
                        android:text="@string/mylauncher_stop_game"
                        android:textAllCaps="false"
                        android:textSize="9sp"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/home_bottom_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:padding="8dp"
            android:background="#141820">
            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:background="@drawable/mylauncher_dark_card"
                android:textColor="#FFFFFF"
                android:drawableEnd="@drawable/spinner_arrow"
                android:paddingStart="10dp"
                app:drawableEndPadding="@dimen/_1sdp"
                app:drawableEndSize="@dimen/_12sdp"
                app:drawableStartIntegerScaling="true"
                app:drawableStartSize="@dimen/_36sdp"/>
            <com.kdt.mcgui.MineButton
                android:id="@+id/play_button"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="0.9"
                android:layout_marginStart="10dp"
                android:backgroundTint="#42B82E"
                android:text="@string/main_play"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textAllCaps="true"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
