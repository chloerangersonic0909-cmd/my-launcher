<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A10">

    <ScrollView
        android:id="@+id/home_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="22dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/home_bottom_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/mylauncher_brand_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MY LAUNCHER"
                        android:textColor="#FFFFFF"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="JAVA EDITION"
                        android:textColor="#A9A7BA"
                        android:textSize="10sp"
                        android:letterSpacing="0.10" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/mylauncher_settings_button"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/mylauncher_circle_button"
                    android:contentDescription="Settings"
                    android:padding="13dp"
                    android:src="@drawable/ic_menu_settings"
                    android:tint="#FFFFFF" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/download_center_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/mylauncher_circle_button_accent"
                    android:contentDescription="Mods and Modpacks"
                    android:drawableStart="@drawable/ic_add_modded"
                    android:gravity="center"
                    android:text=""
                    android:textColor="#FFFFFF" />

                <LinearLayout
                    android:layout_width="58dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageButton
                        android:id="@+id/edit_profile_button"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/mylauncher_circle_button"
                        android:contentDescription="@string/mylauncher_edit_profile"
                        android:padding="8dp"
                        android:src="@drawable/ic_edit_profile"
                        android:tint="#75DDF2" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="PLAYER"
                        android:textColor="#B8B7C7"
                        android:textSize="8sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/mylauncher_dark_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR NEXT ADVENTURE"
                    android:textColor="#70D9F2"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Ready to play?"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="เลือกเวอร์ชันและตั้งค่าก่อนเริ่มเกม Minecraft Java Edition"
                    android:textColor="#B8B7C7"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/background_status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:padding="11dp"
                    android:background="#1B1B29"
                    android:text="@string/mylauncher_game_not_running"
                    android:textColor="#EAEAF2"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/background_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <Button
                        android:id="@+id/background_permission_button"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="@string/mylauncher_enable_notifications"
                        android:textAllCaps="false"
                        android:textSize="10sp" />
                    <Button
                        android:id="@+id/stop_game_button"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:enabled="false"
                        android:text="@string/mylauncher_stop_game"
                        android:textAllCaps="false"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="11dp"
                android:text="LIBRARY &amp; TOOLS"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/install_version_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/mylauncher_dark_card"
                    android:drawableStart="@android:drawable/ic_menu_add"
                    android:text="@string/mylauncher_install_version"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/security_center_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/mylauncher_dark_card"
                    android:drawableStart="@android:drawable/ic_lock_lock"
                    android:text="@string/mylauncher_security_center"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/custom_control_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/mylauncher_dark_card"
                    android:drawableStart="@drawable/ic_menu_custom_controls"
                    android:text="@string/mcl_option_customcontrol"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="9dp"
                android:text="COMMUNITY &amp; SUPPORT"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/install_jar_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/mylauncher_dark_card"
                android:drawableStart="@drawable/ic_menu_install_jar"
                android:text="@string/main_install_jar_file"
                android:textColor="#FFFFFF" />
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/news_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/mylauncher_dark_card"
                android:drawableStart="@drawable/ic_menu_news"
                android:text="@string/mcl_tab_wiki"
                android:textColor="#FFFFFF" />
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/discord_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/mylauncher_dark_card"
                android:drawableStart="@drawable/ic_discord"
                android:text="@string/mcl_button_discord"
                android:textColor="#FFFFFF" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/share_logs_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/mylauncher_dark_card"
                    android:drawableStart="@android:drawable/ic_menu_share"
                    android:text="@string/main_share_logs"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/open_files_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/mylauncher_dark_card"
                    android:drawableStart="@drawable/ic_folder"
                    android:text="@string/mcl_button_open_directory"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/home_bottom_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp"
        android:background="#0D111B"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/mylauncher_dark_card"
                android:textColor="#FFFFFF"
                android:drawableEnd="@drawable/spinner_arrow"
                android:paddingStart="10dp"
                app:drawableEndPadding="@dimen/_1sdp"
                app:drawableEndSize="@dimen/_12sdp"
                app:drawableStartIntegerScaling="true"
                app:drawableStartSize="@dimen/_36sdp" />
        </LinearLayout>

        <com.kdt.mcgui.MineButton
            android:id="@+id/play_button"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#35C2DF"
            android:text="@string/main_play"
            android:textColor="#061018"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>